{
  "name": "boss-ai-edge-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BOSS 求职 AI 助手 · Edge 浏览器扩展（Manifest V3）",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite build --watch -c vite.config.ts",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs",
    "test": "vitest run --passWithNoTests",
    "check:encoding": "node scripts/check-encoding.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "e2e": "node scripts/e2e-edge.mjs"
  },
  "dependencies": {
    "marked": "^14.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/chrome": "^0.0.280",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "adm-zip": "^0.5.16",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
